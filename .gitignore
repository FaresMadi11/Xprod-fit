# ══════════════════════════════════════════
#  Xprod Fit — .gitignore
# ══════════════════════════════════════════

# ── Secretos y configuración sensible ──
.env
.env.local
.env.*.local
config/local.php

# ── Subidas de usuarios ──
uploads/
!uploads/.gitkeep

# ── Contraseñas / datos sensibles ──
contrasenas/

# ── Logs ──
logs/
*.log

# ── Archivos temporales / scratch / backups ──
scratch/
storage/backups/
*.tmp
*.bak
*.swp
*.sql

# ── Dependencias (si se agrega Composer en el futuro) ──
/vendor/
!assets/vendor/
!assets/vendor/**
node_modules/

# ── IDEs ──
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini

# ── PHP opcache ──
*.php.cache

# ── Archivos de prueba ──
test_*.php
fix_*.php
check.php
kogane_test.php
diagrama.html
