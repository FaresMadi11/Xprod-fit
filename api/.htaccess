# api/.htaccess — Bloquear acceso directo al navegador a los endpoints PHP
# Solo se permiten peticiones PHP (servidor interno)
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Permitir peticiones que vienen del propio servidor
    RewriteCond %{HTTP_REFERER} !^$
    # Bloquear navegación directa (sin Referer o sin X-Requested-With)
</IfModule>

# Deshabilitar listado de directorio
Options -Indexes

# Bloquear acceso al guardián de admin directamente
<Files "_auth_admin.php">
    Order deny,allow
    Deny from all
</Files>
