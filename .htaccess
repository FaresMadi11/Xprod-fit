# ══════════════════════════════════════════════════════════════
#  Xprod Fit — .htaccess Principal
#  Apache 2.4+ / XAMPP compatible
# ══════════════════════════════════════════════════════════════

# ── Seguridad básica ───────────────────────────────────────────
Options -Indexes -MultiViews
ServerSignature Off

# ── Motor de reescritura ───────────────────────────────────────
RewriteEngine On

# ── Forzar HTTPS en producción ─────────────────────────────────
# ⚠️ Descomentar SOLO cuando tengas certificado SSL configurado:
# RewriteCond %{HTTPS} off
# RewriteCond %{HTTP_HOST} !^localhost
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── Bloquear acceso directo a archivos y carpetas sensibles ───────────
# Bloquear cualquier archivo o directorio que empiece por punto (.git, .env, .gitignore, .agents, etc.)
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# Bloquear acceso a directorios de código fuente, almacenamiento y utilidades
RewriteRule ^(config|core|models|database|controllers|scratch|storage|libs)/(.*)$ - [F,L]

# Bloquear archivos PHP de utilidades y pruebas
RewriteRule ^(fix_|check|test_|kogane_).*\.php$ - [F,L]

# Prohibir acceso explícito a dotfiles mediante directiva FilesMatch
<FilesMatch "^\.">
    Require all denied
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Headers de Seguridad HTTP ──────────────────────────────────
<IfModule mod_headers.c>
    # Previene MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Previene clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # XSS Protection legacy (IE/Edge)
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy — desactivar APIs no usadas
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=()"

    # Eliminar header que revela tecnología
    Header always unset X-Powered-By
    Header unset X-Powered-By

    # Content Security Policy (CSP)
    # ⚠️ En XAMPP con HTTPS desactivado, usar http: en los sources
    # Ajustar si añades nuevos CDNs
    Header always set Content-Security-Policy "\
        default-src 'self'; \
        script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://accounts.google.com; \
        style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; \
        font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; \
        img-src 'self' data: https://lh3.googleusercontent.com; \
        connect-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com https://fonts.gstatic.com https://accounts.google.com https://oauth2.googleapis.com; \
        frame-src https://accounts.google.com; \
        form-action 'self'; \
        base-uri 'self';"

    # HSTS — Solo activar con HTTPS real
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Permitir carga y decodificación de assets estáticos locales en Canvas/PWA
    <FilesMatch "\.(jpe?g|png|gif|svg|webp|ico|woff2?)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# ── Compresión Gzip / Deflate ──────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE application/font-woff2

    # Asegurar compresión incluso si el cliente declara que no la soporta (navegadores buggy)
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|woff2?)$ no-gzip dont-vary
    Header append Vary Accept-Encoding env=!no-gzip
</IfModule>

# ── Brotli (si está disponible — servidores Linux modernos) ───
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml font/woff2
</IfModule>

# ── Cache del navegador (Browser Caching) ─────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML — no cachear (siempre fresco)
    ExpiresByType text/html                    "access plus 0 seconds"
    ExpiresByType application/xhtml+xml        "access plus 0 seconds"

    # CSS / JavaScript — 1 año (usar versionado en URL: ?v=1.2)
    ExpiresByType text/css                     "access plus 1 year"
    ExpiresByType application/javascript       "access plus 1 year"
    ExpiresByType text/javascript              "access plus 1 year"

    # Imágenes
    ExpiresByType image/jpeg                   "access plus 1 year"
    ExpiresByType image/png                    "access plus 1 year"
    ExpiresByType image/webp                   "access plus 1 year"
    ExpiresByType image/gif                    "access plus 6 months"
    ExpiresByType image/svg+xml                "access plus 1 year"
    ExpiresByType image/x-icon                 "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon     "access plus 1 year"

    # Fuentes
    ExpiresByType font/woff                    "access plus 1 year"
    ExpiresByType font/woff2                   "access plus 1 year"
    ExpiresByType application/font-woff        "access plus 1 year"
    ExpiresByType application/font-woff2       "access plus 1 year"

    # JSON / XML (APIs)
    ExpiresByType application/json             "access plus 0 seconds"
    ExpiresByType application/xml              "access plus 0 seconds"
</IfModule>

# ── Cache-Control headers complementarios ─────────────────────
<IfModule mod_headers.c>
    # Assets estáticos: inmutables por 1 año
    <FilesMatch "\.(css|js|woff2?|png|jpg|jpeg|webp|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Service Worker y Manifest: NUNCA cachear en navegador (actualización inmediata)
    <FilesMatch "(sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </FilesMatch>

    # PHP / HTML: nunca cachear
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ── ETags ──────────────────────────────────────────────────────
# Desactivar ETags basados en inode (poco útiles en servidores múltiples)
FileETag MTime Size

# ── Router principal ───────────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
